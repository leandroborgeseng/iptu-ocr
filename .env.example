# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_32_OU_MAIS_CARACTERES
ADMIN_USER=admin
ADMIN_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
# true para HTTPS no Coolify; false apenas para localhost HTTP
COOKIE_SECURE=true

# Limites de envio de pastas (MB = 1024*1024 bytes)
UPLOAD_MAX_FILE_MB=100
UPLOAD_MAX_BATCH_MB=65536
UPLOAD_MAX_FILES=20000

# Páginas analisadas em paralelo (1 a 16). Padrão: 12 para o servidor com 16 processadores.
DETECTOR_WORKERS=12

# ZIPs: limite por pacote e soma dos pacotes ainda armazenados (MiB).
ZIP_MAX_FILE_MB=65536
ZIP_MAX_STORED_MB=65536
